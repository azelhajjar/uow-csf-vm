#!/bin/bash
set -eu

# FTP provisioning for vulnerable lab environment
# - vsftpd 2.3.4 on port 21 (classic backdoor vulnerability)
# - pyftpdlib misconfigured instance on port 2121

export DEBIAN_FRONTEND=noninteractive

echo "[*] Installing dependencies..."
apt-get update -qq
apt-get install -y -qq build-essential libssl-dev libpam0g-dev python3-pip wget

pip3 install pyftpdlib==1.5.8

echo "[*] Preparing directories..."
mkdir -p /opt/vsftpd-2.3.4/sbin /opt/vsftpd-2.3.4/etc /opt/pyvulnftp
mkdir -p /srv/cav-csf/vsftpd_vuln /srv/cav-csf/pyvulnftp
chmod 777 /srv/cav-csf/vsftpd_vuln /srv/cav-csf/pyvulnftp

echo "[*] Fetching and compiling vsftpd 2.3.4..."
cd /tmp
if [ ! -f vsftpd-2.3.4.tar.gz ]; then
    wget -q https://security.appspot.com/downloads/vsftpd-2.3.4.tar.gz || \
    wget -q https://download.sourceforge.net/project/vsftpd/vsftpd-2.3.4.tar.gz
fi
tar xzf vsftpd-2.3.4.tar.gz
cd vsftpd-2.3.4
make -s || true
cp vsftpd /opt/vsftpd-2.3.4/sbin/vsftpd || true
cp /srv/cav-csf/configs/vsftpd-2.3.4.conf /opt/vsftpd-2.3.4/etc/vsftpd.conf
chown -R root:root /opt/vsftpd-2.3.4

echo "[*] Deploying pyftpdlib service..."
cp /srv/cav-csf/configs/pyvulnftp.py /opt/pyvulnftp/pyvulnftp.py
cp /srv/cav-csf/configs/pyvulnftp.service /etc/systemd/system/pyvulnftp.service
chown -R root:root /opt/pyvulnftp
chmod 644 /opt/pyvulnftp/pyvulnftp.py

echo "[*] Deploying vsftpd 2.3.4 service..."
cp /srv/cav-csf/configs/vsftpd-2.3.4.service /etc/systemd/system/vsftpd-2.3.4.service

echo "[*] Enabling both services..."
systemctl daemon-reload
systemctl disable vsftpd 2>/dev/null || true
systemctl enable --now vsftpd-2.3.4.service
systemctl enable --now pyvulnftp.service

echo "[+] FTP setup complete."
echo "    - vsftpd 2.3.4 running on port 21"
echo "    - pyftpdlib running on port 2121"
